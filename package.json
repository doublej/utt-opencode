      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.31",
    "@opencode/theme": "2.0.31",
    "@opentui/core": "0.5.17",
    "@opentui/solid": "0.5.17",
