    "voice-typing",
    "macos",
    "on-device",
    "local-first",
    "offline",
    "parakeet",
    "whisper",
    "ai-coding-agent",
    "coding-agent",
    "tui",
    "privacy",
    "transcription"
  ],
  "homepage": "https://utt.jurrejan.com/extensions/opencode/",
  "bugs": "https://github.com/doublej/utt-opencode/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doublej/utt-opencode.git"
  },
  "os": [
    "darwin"
  ],
  "exports": {
    "./tui": "./dist/tui.js",
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "dist"
  ],
  "scripts": {
    "build": "bun build.ts",
    "prepack": "bun build.ts",
    "check": "tsc --noEmit",
    "test": "bun test"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.31",
